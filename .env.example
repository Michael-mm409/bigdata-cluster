WORKER_RAM=8G
COURSE_WORKSPACE='path/to/course_workspace'

# PostgreSQL (course-postgres container)
# Connect via: localhost:5432, db=csc6002, user=postgres
POSTGRES_DB=csc6002
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MongoDB Datastore Options
# -------------------------------------------------------------
# Option A: Home Lab Configuration (Mini PC Node)
MONGO_URI="mongodb://192.168.8.10:27017/csc6002_lab"

# Option B: Portable Fallback Configuration (Local Docker/Laptop)
# MONGO_URI="mongodb://localhost:27017/csc6002_lab"
