#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

if [ -f "$PROJECT_ROOT/.env" ]; then
    source "$PROJECT_ROOT/.env"
fi

if [ $# -lt 1 ]; then
    echo "Usage: spark-submit <python-file> [spark-submit options]"
    exit 1
fi

if [ -z "${COURSE_WORKSPACE:-}" ]; then
    echo "COURSE_WORKSPACE is not set"
    exit 1
fi

relative_path="${PWD#$COURSE_WORKSPACE}"
relative_path="${relative_path#/}"

docker exec -it spark-master \
    /opt/spark/bin/spark-submit \
    "/course/${relative_path}/$1"
